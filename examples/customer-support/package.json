{
  "name": "support-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "starter-app",
    "starter-web"
  ],
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web --prefix-colors blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm --prefix starter-app run dev",
    "dev:web": "npm --prefix starter-web run dev",
    "start": "npm --prefix starter-app run start",
    "build": "npm --prefix starter-web run build",
    "preview": "npm --prefix starter-web run preview",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:seed": "node scripts/database.mjs seed",
    "db:setup": "node scripts/database.mjs setup",
    "db:check": "node scripts/database.mjs check",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "setup": "npm run db:setup",
    "test": "npm run verify:boundaries && vitest run",
    "verify:boundaries": "node scripts/release/verify-consumer.mjs",
    "check": "npm test && npm run build",
    "core:upgrade": "node scripts/release/upgrade.mjs",
    "core:verify": "node scripts/release/verify-consumer.mjs"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "pg": "^8.16.3",
    "@yuva/billing-core": "file:vendor/yuva-core/1.2.0/yuva-billing-core-1.2.0.tgz"
  },
  "devDependencies": {
    "concurrently": "^10.0.0",
    "vitest": "^4.1.8"
  }
}
