# Local development template. Never use these sample credentials in production.
# Copy to starter-app/.env; keep real credentials out of Git.

# Server Configuration
PORT=3000
NODE_ENV=development
# Set to true only in development/test environments to allow unauthenticated guest access
ALLOW_DEV_GUEST=true
# One-time initial grant; rerunning db:seed does not refill a spent balance.
DEV_GUEST_CREDITS=25
DOMAIN_KEY=vertical-agent-saas
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
JSON_BODY_LIMIT=256kb

# Database (PostgreSQL)
DATABASE_URL=postgresql://starter:starter@localhost:5432/starter_agent

# LLM Provider Configuration
# Supported providers: mock (local only), openai, anthropic
# For a compatible Responses endpoint, select openai and configure OPENAI_BASE_URL.
AI_PROVIDER=mock
# Optional when AI_PROVIDER=mock. Required for a real OpenAI provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Select a Responses-compatible model available to your provider account.
OPENAI_MODEL=gpt-4o

# Optional Anthropic Provider: select a currently available model for your account.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Authentication (@yuva/auth-core): configure real authentication before deployment.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
AUTH_TOKEN_SECRET=development_auth_secret_minimum_32_chars_long_12345
