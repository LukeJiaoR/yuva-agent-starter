# Local development template. Never use these sample credentials in production.
# Copy to starter-app/.env; keep real credentials out of Git.

# Server Configuration
PORT=3000
NODE_ENV=development
# Set to true only in development/test environments to allow unauthenticated guest access
ALLOW_DEV_GUEST=true
# One-time initial grant; rerunning db:seed does not refill a spent balance.
DEV_GUEST_CREDITS=25
DOMAIN_KEY=vertical-agent-saas
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
JSON_BODY_LIMIT=256kb

# Database (PostgreSQL)
DATABASE_URL=postgresql://starter:starter@localhost:5432/starter_agent

# LLM Provider Configuration
# Supported providers: mock (local only), openai, anthropic
# For a compatible Responses endpoint, select openai and configure OPENAI_BASE_URL.
AI_PROVIDER=mock
# Optional when AI_PROVIDER=mock. Required for a real OpenAI provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Select a Responses-compatible model available to your provider account.
OPENAI_MODEL=gpt-4o

# Optional Anthropic Provider: select a currently available model for your account.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Authentication: explicit mode; existing Clerk installations remain unchanged.
# See docs/self-hosted-auth.md for the email/password + local inbox quickstart.
AUTH_MODE=clerk

# Self-hosted auth (requires AUTH_MODE=self-hosted, ALLOW_DEV_GUEST=false).
# Supply your own private random 32+ character secret. No production fallback.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
AUTH_TRUSTED_ORIGINS=http://localhost:5173
AUTH_MAIL_MODE=capture
AUTH_SIGNUP_CREDITS=25
# Production uses SMTP with verified TLS (465) or mandatory STARTTLS (587).
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=465
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=
AUTH_MAIL_FROM=

# Clerk adapter configuration (AUTH_MODE=clerk).
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
AUTH_TOKEN_SECRET=development_auth_secret_minimum_32_chars_long_12345

# Image artifact storage is disabled unless explicitly enabled by the operator.
# Local POSIX adapter only; see docs/artifact-storage.md. No S3 integration.
ARTIFACT_STORAGE=disabled
# Pre-create a dedicated absolute directory, owned by the service UID, mode 0700.
# ARTIFACT_DIRECTORY=/var/lib/starter/artifacts
# Optional private durable stage-before-publish recovery; requires local storage.
ARTIFACT_STAGING=disabled
# Pre-create a second dedicated UID-owned 0700 durable directory, disjoint from ARTIFACT_DIRECTORY.
# ARTIFACT_STAGING_DIRECTORY=/var/lib/starter/artifact-staging

# Separate trusted HTTPS ingestion is disabled; no default source host.
ARTIFACT_REMOTE_INGESTION=disabled
ARTIFACT_REMOTE_TRUSTED_HOSTNAMES=

# Local development MOCK image product only. Does not call an image provider.
# Requires NODE_ENV=development/test and both private local storage directories above.
# No default image price/profile; see docs/mock-image-product.md for explicit demo config.
MOCK_IMAGE_GENERATION=disabled
# MOCK_IMAGE_PROFILE={...explicit synthetic profile...}

# Opt-in metadata-only operation reads. Cross-account access also requires a trusted server resolver.
OPERATIONS_VIEW=disabled

# Synthetic checkout is OFF by default: no money, vendor calls, or credits granted.
MOCK_CHECKOUT=disabled
# To opt in locally, use local-development and NODE_ENV=development/test.
# First independently verify DATABASE_URL targets a disposable development DB.
# Acknowledgement is an operator declaration, NOT technical proof of DB isolation.
# MOCK_CHECKOUT_DISPOSABLE_DB=acknowledged
# Exact loopback browser origin, without trailing slash; required on mutations.
# MOCK_CHECKOUT_TRUSTED_ORIGIN=http://localhost:5173
