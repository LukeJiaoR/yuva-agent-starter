# Server Configuration
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/starter_agent_db

# LLM Provider Configuration
# Supported providers: openai (default), anthropic, deepseek (via OpenAI base URL), ollama
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Optional Anthropic Provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Authentication (@yuva/auth-core)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
AUTH_TOKEN_SECRET=development_auth_secret_minimum_32_chars_long_12345
