# Copy outside the repository to the deployment secret store.
COMPOSE_PROJECT_NAME=my-ai-product-prod
WEB_PORT=8080
NODE_ENV=production
ALLOW_DEV_GUEST=false
DOMAIN_KEY=my-ai-product
PORT=3000
DATABASE_URL=postgresql://app:<password>@<database-host>:5432/<project-production-db>
CORS_ORIGIN=https://<frontend-domain>
AI_PROVIDER=openai
OPENAI_BASE_URL=https://<provider-host>/v1
OPENAI_MODEL=<approved-model-id>
OPENAI_API_KEY=<provider-secret-reference>
CLERK_SECRET_KEY=<clerk-production-secret-reference>
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=https://<frontend-domain>
AUTH_TOKEN_SECRET=<unique-secret-at-least-32-characters>
